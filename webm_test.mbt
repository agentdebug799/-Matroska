    b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00" +
    b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00" +
    b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00" +
    b"\x00\x00\x00\x00\x79\xF8\x78\x1E\x66\x58\x4A\x20\xBE\x7F\x93\xCA\x03\x48\x97\x88\xEF" +
    b"\x1B\xE2\x99\xEB\xC4\x77\x82\xB3\x0D\xB4\x6F\xCF\xEC\x03\xF6\x5B\x08\x87\x3E\x8F\x0A" +
    b"\xD8\x64\x43\x9F\x48\x4C\x81\x99\xFC\x79\x67\x5E\xA9\x12\xA5\xEE\xF4\xC3\x5B\x3B\x3A" +
    b"\xF8\xAF\xE4\xB4\xCB\x4E\xD0\xE3\xFC\x10\x4F\x07\xC9\xF4\x9D\x90\xD2\xFF\xA7\x00\x12" +
    b"\x50\x03\x37\x85\x12\xBE\x0B\xA0\x76\x0E\x3C\x5E\x6B\x46\xDB\x26\xB5\x3E\x75\x17\xD8" +
    b"\x16\x0B\xC3\x65\x0D\x9E\x73\xC6\x5E\x2C\x57\x7F\x52\x4F\xFD\x59\xD9\x9C\xFC\xF5\x93" +
    b"\x5C\xA8\x75\x78\x42\x1E\x17\x6C\x01\x33\xFE\x91\x16\xC4\xED\xFF\xE0\x6D\x6A\x5F\xA4" +
    b"\xDF\xE4\xDB\x5D"

test "parse a real ffmpeg-authored WebM" {
  let doc = @matroska.parse(real_webm)

  assert_eq(doc.header.doctype, "webm")
  assert_eq(doc.info.timecode_scale, 1000000)
  assert_eq(doc.info.duration, 6008.0)
  assert_eq(doc.info.muxing_app, "Lavf60.16.100")
  assert_eq(doc.info.writing_app, "Lavf60.16.100")

  assert_eq(doc.tracks.entries.length(), 2)

  let video_track = doc.tracks.entries[0]
  assert_eq(video_track.number, 1)
  assert_eq(video_track.track_type, 1)
  assert_eq(video_track.codec_id, "V_VP9")
  assert_eq(video_track.codec_private, b"")
  assert_eq(video_track.language, "und")
  match video_track.video {
    Some(v) => {
      assert_eq(v.pixel_width, 854)
      assert_eq(v.pixel_height, 480)
    }
    None => assert_true(false)
  }

  let audio_track = doc.tracks.entries[1]
  assert_eq(audio_track.number, 2)
  assert_eq(audio_track.track_type, 2)
  assert_eq(audio_track.codec_id, "A_OPUS")
  assert_eq(audio_track.codec_private, b"\x4F\x70\x75\x73\x48\x65\x61\x64\x01\x02\x38\x01\x80\xBB\x00\x00\x00\x00\x00")
  assert_eq(audio_track.language, "und")
  match audio_track.audio {
    Some(a) => {
      assert_eq(a.sampling_frequency, 48000.0)
      assert_eq(a.channels, 2)
      assert_eq(a.bit_depth, 32)
    }
    None => assert_true(false)
  }

  assert_eq(doc.clusters.length(), 1)
  let c = doc.clusters[0]
  assert_eq(c.timecode, 0)
  assert_eq(c.frames.length(), 1)
  assert_eq(c.frames[0].track_number, 2)
  assert_eq(c.frames[0].timecode, 0)
  assert_true(c.frames[0].keyframe)
  assert_eq(c.frames[0].data.length(), 635)
}
