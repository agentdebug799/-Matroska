    b"\x02\x55\xB0\x84\x55\xB9\x81\x01\xAE\x01\x00\x00\x00\x00\x00\x00\x5C\xD7\x81\x02\x73" +
    b"\xC5\x88\x14\x20\xAB\xD6\x14\xA5\x64\x68\x9C\x81\x00\x22\xB5\x9C\x83\x75\x6E\x64\x88" +
